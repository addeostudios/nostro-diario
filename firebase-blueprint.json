{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "coupleId": { "type": "string", "description": "ID of the shared couple space" },
        "birthday": { "type": "string", "format": "date" }
      },
      "required": ["uid", "email"]
    },
    "Couple": {
      "title": "Couple",
      "description": "Shared space for a couple",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "anniversaryDate": { "type": "string", "format": "date" },
        "memberUids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "memberUids"]
    },
    "Photo": {
      "title": "Photo",
      "description": "A photo entry in the diary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleId": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "dateTaken": { "type": "string", "format": "date-time" },
        "month": { "type": "integer" },
        "year": { "type": "integer" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "uploaderUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "coupleId", "url", "dateTaken", "month", "year", "uploaderUid"]
    },
    "Badge": {
      "title": "Badge",
      "description": "Custom colored badges for grouping photos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleId": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["id", "coupleId", "name", "color"]
    },
    "ImportantDate": {
      "title": "Important Date",
      "description": "Dates for the calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["anniversary", "birthday", "mensiversary", "other"] }
      },
      "required": ["id", "coupleId", "title", "date", "type"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "couples/{coupleId}": {
      "schema": "Couple",
      "description": "Shared couple spaces"
    },
    "photos/{photoId}": {
      "schema": "Photo",
      "description": "Photo diary entries"
    },
    "badges/{badgeId}": {
      "schema": "Badge",
      "description": "Custom categories"
    },
    "importantDates/{dateId}": {
      "schema": "ImportantDate",
      "description": "Calendar events"
    }
  }
}
